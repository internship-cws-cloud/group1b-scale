# Terraform working directory
.terraform/

# Terraform state
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform variable files - may contain secrets
*.tfvars
*.tfvars.json

# Allow the safe example variables file
!example.tfvars

# Terraform plan files
tfplan
*.tfplan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local environment / OS files
.env
.DS_Store
Thumbs.db
